# Copy to .env. Use this agent only against an explicitly authorized,
# isolated cyber range. Keep the real file out of version control.

# LLM provider: openai, claude/anthropic, gemini, or local.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local Ollama or an OpenAI-compatible local endpoint.
LOCAL_LLM_BACKEND=ollama
LOCAL_LLM_MODEL=llama3.1
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LLM_BASE_URL=
LLM_API_KEY=

# SSH attacker/execution VM -> authorized target.
TARGET_HOST=192.168.56.100
TARGET_USERNAME=root
TARGET_PASSWORD=kali

# Planner limits. Zero means no limit for the corresponding Cochise setting.
MAX_RUN_TIME=0
PLANNER_MAX_CONTEXT_SIZE=250000
PLANNER_MAX_INTERACTIONS=0

# Optional range context. A specification is data only; it is not a command list.
CYBERQA_SCENARIO_ID=cyberqa-run
CYBERQA_SCENARIO_FILE=
CYBERQA_SPEC_PATH=

# Each invocation creates <scenario>_<UTC timestamp>_<id>/logs/run-*.json,
# report.md, run-meta.json, and (when a spec is supplied) qa-assessment.md.
CYBERQA_RUNS_DIR=runs
