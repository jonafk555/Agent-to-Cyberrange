# Copy to .env and keep the real file out of git.
OPENAI_API_KEY=
CYBERQA_LLM_PROVIDER=openai
CYBERQA_LLM_MODEL=gpt-4.1-mini

# CLI defaults
CYBERQA_TARGET=10.0.0.0/24
CYBERQA_SCENARIO_ID=demo
CYBERQA_OBJECTIVE=Validate the cyber range baseline and produce a QA report
CYBERQA_MAX_ITERATIONS=12
CYBERQA_ALLOWED_TARGETS=10.0.0.0/24
# Optional comma-separated Kali interface addresses to exclude from Nmap CIDR scans.
CYBERQA_LOCAL_IPS=
CYBERQA_REPORT_DIR=reports
CYBERQA_OBSERVATION_DB=.cyberqa/observations.sqlite3
CYBERQA_OBSERVATION_TTL_SECONDS=0
CYBERQA_DISCOVERED_ENV=.cyberqa/discovered.env

# Expected QA baseline (comma-separated; leave blank to discover and report only)
CYBERQA_EXPECTED_LOCAL_USERS=
CYBERQA_EXPECTED_DOMAIN_USERS=
CYBERQA_EXPECTED_PRIVILEGED_GROUPS=Administrators,Domain Admins
CYBERQA_EXPECTED_OPEN_PORTS=
CYBERQA_EXPECTED_NETWORKS=

# Optional lab identity references. Keep secrets in a secret manager in production.
CYBERQA_AD_DOMAIN=
CYBERQA_AD_USERNAME=
CYBERQA_AD_PASSWORD=
CYBERQA_AD_DC=
CYBERQA_AD_BASE_DN=
CYBERQA_AD_COLLECTION=DCOnly
CYBERQA_AD_USERS_FILE=
# Read-only anonymous LDAP/NXC discovery is the default first branch in a range.
CYBERQA_ALLOW_ANONYMOUS_NXC=1

# Optional durable services
REDIS_URL=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
RABBITMQ_URL=
